{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@bandaro/config": [
        "../../packages/config/src"
      ],
      "@bandaro/core": [
        "../../packages/core/src"
      ],
      "@bandaro/ui": [
        "../../packages/ui/src"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}