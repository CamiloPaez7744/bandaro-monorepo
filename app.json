{
  "expo": {
    "name": "Bandaro",
    "slug": "bandaro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Bandaro.PNG",
    "scheme": "bandaro",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/Bandaro.PNG",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bandaro.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Bandaro.PNG"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Bandaro.PNG"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9251e2d-eb95-4cec-8772-1f006831b07a"
      }
    },
    "owner": "camilopaez117"
  }
}